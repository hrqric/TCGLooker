# Use the Direct connection for a persistent IPv6-capable backend.
# Use the Supavisor Session Pooler (port 5432) when the runtime is IPv4-only.
# Never commit the real password.
ConnectionStrings__DefaultConnection=Host=YOUR_HOST;Port=5432;Database=postgres;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=VerifyFull;GSS Encryption Mode=Disable

# Supabase Auth issuer. Configure an asymmetric JWT signing key (ES256 or RS256).
Supabase__Authority=https://YOUR_PROJECT_REF.supabase.co/auth/v1
Supabase__Audience=authenticated

# Local-only authentication bypass. It is rejected outside ASPNETCORE_ENVIRONMENT=Development.
dev=false

# Scraping: evenly spaced requests, shared by connectors within each process.
Scraping__RequestsPerMinute=6
Scraping__GlobalRequestsPerMinute=12
Scraping__JitterMilliseconds=500
Scraping__RequestTimeoutSeconds=30
Scraping__MaxRetries=2
Scraping__ForbiddenRetryHours=24
Scraping__RateLimitRetryMinutes=30
Scraping__RunFullOnStartup=false
Scraping__UserAgent=TCGLooker/0.1
# Optional persistent path, writable by the process. Use a separate file per process.
# Scraping__CooldownStatePath=/persistent/worker-scraping-cooldowns.json

# Optional fixed proxy you control. No rotation or direct fallback on failure.
Scraping__Proxy__Enabled=false
Scraping__Proxy__Url=
Scraping__Proxy__Username=
Scraping__Proxy__Password=
