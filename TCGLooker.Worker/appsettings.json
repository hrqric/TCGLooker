{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Scraping": {
    "StoreRefreshSeconds": 30,
    "IntervalMinutes": 15,
    "MaxPagesPerRun": 1,
    "Refresh": {
      "Enabled": true,
      "StaleAfterMinutes": 150,
      "PollingMinutes": 5,
      "MaxProductsPerRun": 10,
      "FailureRetryMinutes": 30
    },
    "OutOfStockRetentionDays": 30,
    "ForbiddenRetryHours": 24,
    "RateLimitRetryMinutes": 30,
    "RequestsPerMinute": 6,
    "GlobalRequestsPerMinute": 12,
    "JitterMilliseconds": 500,
    "RequestTimeoutSeconds": 30,
    "MaxRetries": 2,
    "UserAgent": "TCGLooker/0.1",
    "Proxy": {
      "Enabled": false,
      "Url": "",
      "Username": "",
      "Password": ""
    }
  },
  "Notifications": {
    "OutboxPollingSeconds": 15,
    "OutboxBatchSize": 100
  }
}
